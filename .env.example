# ===================================================================
# SECURE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace all placeholder values.
# DO NOT COMMIT THE REAL .env FILE TO GIT OR DOCKER IMAGES!
# ===================================================================

# --- Frappe Site Settings ---
SITE_NAME=erp.example.com
HTTP_PORT=8000
SOCKETIO_PORT=9000
DEVELOPER_MODE=0
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# --- MariaDB Database Credentials ---
DB_ROOT_PASSWORD=CHANGE_ME_RANDOM_DATABASE_ROOT_PASSWORD

# --- Frappe Administrator Account ---
ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMINISTRATOR_PASSWORD

# --- Container / Bench Versions ---
FRAPPE_VERSION=version-15
ERPNEXT_VERSION=version-15
