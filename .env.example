# ===================================================================
# SECURE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace all placeholder values.
# DO NOT COMMIT THE REAL .env FILE TO GIT OR DOCKER IMAGES!
# ===================================================================

# --- Frappe Site Settings ---
SITE_NAME=development.localhost
HTTP_PORT=8001
DEVELOPER_MODE=1

# --- MariaDB Database Credentials ---
DB_ROOT_PASSWORD=SecretDbRootPassword123!
DB_NAME=frappe_dev_db
DB_USER=frappe_user
DB_PASSWORD=SecretDbUserPassword123!

# --- Frappe Administrator Account ---
ADMIN_PASSWORD=SecretAdminPassword123!

# --- Encryption & Secret Keys ---
# Generate random 32-character strings for key isolation across environments
ENCRYPTION_KEY=SecretEncryptionKeyChangeMe32Char!
SECRET_KEY=SecretSessionKeyChangeMe32Chars!

# --- Container / Bench Versions ---
FRAPPE_VERSION=version-15
ERPNEXT_VERSION=version-15
