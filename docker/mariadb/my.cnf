[mysqld]
# ==============================================================================
# MariaDB Production Configuration for Frappe v15 / ERPNext (VPS Optimized)
# ==============================================================================

# Character set & collation for Frappe utf8mb4 compliance
character-set-client-handshake = FALSE
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Memory limits & Buffer Pool Tuning (Prevents RAM spikes on VPS)
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_buffer_pool_instances = 1
innodb_file_per_table = 1

# Connection & Thread Tuning
max_connections = 100
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600

# Packet sizes for large DocType transactions
max_allowed_packet = 128M
sort_buffer_size = 2M
read_buffer_size = 2M
read_rnd_buffer_size = 4M

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
